NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only. Used by /api/recommend (to read embeddings
# past public RLS) and the backfill script. Must never be exposed to the
# browser. Leave unset in environments where /api/recommend should fall back
# to the cold-start (server-ordered) deck.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
